{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "NFL_EDGE_DAILY_NEWS_V1.schema.json",
  "title": "NFL EDGE Daily News Article V1",
  "type": "object",
  "required": ["schema_version", "published_at_utc", "title", "sections"],
  "properties": {
    "schema_version": {"const": "NFL_EDGE_DAILY_NEWS_V1"},
    "published_at_utc": {"type": "string", "minLength": 1},
    "edition": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "dek": {"type": "string"},
    "research_generated_at_utc": {"type": "string"},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "items"],
        "properties": {
          "id": {"enum": ["what-matters", "what-it-means", "fade", "market-watch", "today-tip"]},
          "title": {"type": "string", "minLength": 1},
          "icon": {"type": "string"},
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["headline", "paragraphs"],
              "properties": {
                "headline": {"type": "string", "minLength": 1},
                "paragraphs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "minLength": 1}
                },
                "bullets": {"type": "array", "items": {"type": "string"}},
                "takeaway": {"type": "string"},
                "editorial_only": {"type": "boolean"},
                "evidence_ids": {"type": "array", "items": {"type": "string"}},
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["url"],
                    "properties": {
                      "label": {"type": "string"},
                      "url": {"type": "string", "pattern": "^https?://"}
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

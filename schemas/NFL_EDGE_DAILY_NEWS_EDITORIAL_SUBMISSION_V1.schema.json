{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "NFL_EDGE_DAILY_NEWS_EDITORIAL_SUBMISSION_V1.schema.json",
  "title": "NFL EDGE Daily News Editorial Submission V1",
  "type": "object",
  "required": ["schema_version", "submitted_at_utc", "research_generated_at_utc", "article", "evidence"],
  "properties": {
    "schema_version": {"const": "NFL_EDGE_DAILY_NEWS_EDITORIAL_SUBMISSION_V1"},
    "submitted_at_utc": {"type": "string", "minLength": 1},
    "research_generated_at_utc": {"type": "string", "minLength": 1},
    "article": {"type": "object"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "fact", "sources"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "category": {"type": "string"},
          "fact": {"type": "string", "minLength": 1},
          "interpretation": {"type": "string"},
          "verification": {"type": "string"},
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["url"],
              "properties": {
                "label": {"type": "string"},
                "url": {"type": "string", "pattern": "^https?://"}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}

# Raw/disposable data not explicitly frozen
/data/raw/
/data/cache/
/data/live_snapshots/private/

# Derived market-data artifacts are normally regenerated from production RAW.
# Task05F requires the exact frozen 05E T-60 canonical inputs for deterministic
# GitHub Actions validation, so ONLY these two historical canonical artifacts are
# permitted in Git. Raw/normalized market data remains ignored.
/data/market_data/
!/data/market_data/
/data/market_data/*
!/data/market_data/canonical/
/data/market_data/canonical/*
!/data/market_data/canonical/canonical_games.parquet
!/data/market_data/canonical/canonical_book_market.parquet

# Local model experiments not explicitly promoted
/artifacts/local/
/artifacts/tmp/

# Frontend dependencies and generated caches
node_modules/
site/node_modules/
site/.cache/
site/.vite/

# Deployment secrets and local staging
deploy/private/
deploy/staging/

# IDE and OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Legacy prototype secret location
.streamlit/secrets.toml

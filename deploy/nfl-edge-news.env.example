# NFL EDGE Daily News V1 production environment example.
# Install as /etc/nfl-edge/news.env with mode 0600.
# Research/writer command credentials, if any, belong in that command's own protected environment.

NFL_EDGE_NEWS_RUNTIME_ROOT=/var/lib/nfl-edge/news_v1
NFL_EDGE_NEWS_EVIDENCE_ROOT=/var/lib/nfl-edge/prospective_repo_v1

# Both commands read one JSON object from stdin and MUST write one JSON object to stdout.
# Research output schema: NFL_EDGE_DAILY_NEWS_EXTERNAL_RESEARCH_V1
# Writer output schema: NFL_EDGE_DAILY_NEWS_V1
#
# Example wrappers:
# NFL_EDGE_NEWS_RESEARCH_COMMAND=/usr/local/bin/nfl-edge-news-research
# NFL_EDGE_NEWS_WRITER_COMMAND=/usr/local/bin/nfl-edge-news-writer
NFL_EDGE_NEWS_RESEARCH_COMMAND=
NFL_EDGE_NEWS_WRITER_COMMAND=

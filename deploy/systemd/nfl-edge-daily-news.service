[Unit]
Description=NFL EDGE Daily News governed publication
Documentation=file:///root/nfl-edge/news/README.md
After=network-online.target nfl-edge-prospective-persistence.service
Wants=network-online.target
Requires=nfl-edge-prospective-persistence.service

[Service]
Type=oneshot
WorkingDirectory=/root/nfl-edge
EnvironmentFile=/etc/nfl-edge/news.env
Environment="PYTHONPATH=/root/nfl-edge/src"
ExecStart=/root/nfl-edge/.venv/bin/python /root/nfl-edge/scripts/nfl_edge_daily_news_v1.py
Restart=no
TimeoutStartSec=7min
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/root/nfl-edge /var/lib/nfl-edge/prospective_repo_v1
ReadWritePaths=/var/lib/nfl-edge/news_v1
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nfl-edge-daily-news

[Install]
WantedBy=multi-user.target

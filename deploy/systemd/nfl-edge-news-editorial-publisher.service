[Unit]
Description=NFL EDGE Daily News deterministic editorial publisher
Documentation=file:///root/nfl-edge/news/README.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/root/nfl-edge/scripts/publish_news_editorial_v1.py
ConditionPathExists=/etc/nfl-edge/news.env

[Service]
Type=oneshot
WorkingDirectory=/root/nfl-edge
EnvironmentFile=/etc/nfl-edge/news.env
Environment="PYTHONPATH=/root/nfl-edge/src"
Environment="PYTHONDONTWRITEBYTECODE=1"
ExecStart=/root/nfl-edge/.venv/bin/python /root/nfl-edge/scripts/publish_news_editorial_v1.py
Restart=no
TimeoutStartSec=1min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/root/nfl-edge
ReadWritePaths=/var/lib/nfl-edge/news_v1
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nfl-edge-news-editorial-publisher

[Install]
WantedBy=multi-user.target

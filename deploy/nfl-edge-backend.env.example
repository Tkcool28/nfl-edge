# NFL EDGE backend production environment example.
# Install as /etc/nfl-edge/backend.env with mode 0600 after VPS inspection.
# This file intentionally contains no secrets or sportsbook-provider credentials.

# Loopback-only API listener; Caddy is the public entrypoint.
NFL_EDGE_BACKEND_HOST=127.0.0.1
NFL_EDGE_BACKEND_PORT=8769

# Persistent runtime state outside the Git working tree.
NFL_EDGE_DB_PATH=/var/lib/nfl-edge/backend/nfl_edge_users_v1.sqlite3
NFL_EDGE_PRODUCT_DIR=/var/lib/nfl-edge/product_v1

# Frozen entering-2026 decision state from the deployed repository commit.
# Do not regenerate/refit this on backend startup.
NFL_EDGE_DECISION_STATE_PATH=/root/nfl-edge/data/live/2026/entering_product_state_v1.json

# Session/auth transport settings.
NFL_EDGE_SESSION_LIFETIME_SECONDS=2592000
NFL_EDGE_SESSION_COOKIE=nfl_edge_session
NFL_EDGE_COOKIE_SECURE=true
NFL_EDGE_COOKIE_SAMESITE=lax
NFL_EDGE_AUTH_RATE_LIMIT_PER_MINUTE=10

# Same-origin production does not require CORS. Leave origin empty unless
# deployment validation demonstrates that an explicit origin is required.
NFL_EDGE_ALLOWED_ORIGIN=
NFL_EDGE_ALLOWED_HOSTS=nfl.tkhermes.duckdns.org,localhost,127.0.0.1
